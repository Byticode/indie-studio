# Copia este archivo a .env y rellena la clave. .env está en .gitignore.
# En Vercel, las mismas variables van en Project Settings → Environment Variables.

# Clave de la API de Resend (https://resend.com/api-keys).
# Sin ella el sitio compila y arranca igual, pero el endpoint responde 503
# con un aviso en lugar de fallar en silencio.
RESEND_API_KEY=

# Remitente. Sin dominio propio verificado por DNS, Resend solo entrega desde
# su dirección de pruebas y ÚNICAMENTE al correo dueño de la cuenta:
#   CONTACTO_REMITENTE=indie studio <onboarding@resend.dev>
# Con dominio verificado, por ejemplo:
#   CONTACTO_REMITENTE=indie studio <hola@indiestudio.com>
CONTACTO_REMITENTE=
