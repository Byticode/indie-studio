---
import '../styles/global.css';

interface Props {
	titulo?: string;
	descripcion?: string;
}

const {
	titulo = 'indie studio — Branding editorial y marketing de precisión',
	descripcion = 'Elevamos marcas a través de dirección de arte editorial y marketing de precisión.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body class="bg-noche text-hueso antialiased">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:bg-hueso focus:px-4 focus:py-2 focus:text-noche"
		>
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
