---
import Icono from './Icono.astro';

// §01 Navegación — su única obligación es que el CTA de contacto
// nunca quede a más de un clic, en cualquier punto del scroll.
const enlaces = [
	{ texto: 'Trabajo', href: '#trabajo' },
	{ texto: 'Servicios', href: '#servicios' },
	{ texto: 'Proceso', href: '#proceso' },
	{ texto: 'Estudio', href: '#estudio' },
];
---

<header
	id="cabecera"
	data-pegada="false"
	class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter] duration-500 data-[pegada=true]:bg-noche/80 data-[pegada=true]:backdrop-blur-md"
>
	<nav
		aria-label="Navegación principal"
		class="mx-auto flex h-20 max-w-[110rem] items-center justify-between px-6 lg:px-10"
	>
		<a
			href="#inicio"
			class="font-display text-[1.1rem] font-medium tracking-[-0.01em] text-hueso"
		>
			indie<span class="text-seda-dim"> studio</span>
		</a>


		<div class="flex items-center gap-4">
			<a
				href="#contacto"
				class="hidden rounded-full bg-seda/12 px-6 py-2.5 font-mono text-[0.8rem] font-medium tracking-[0.14em] text-hueso uppercase transition-colors duration-300 hover:bg-hueso hover:text-noche md:inline-block"
			>
				Iniciar proyecto
			</a>

			<button
				type="button"
				id="menu-boton"
				aria-controls="menu-movil"
				aria-expanded="false"
				class="etiqueta inline-flex items-center gap-2.5 text-hueso md:hidden"
			>
				<span data-menu-texto>Menú</span>
				<Icono nombre="menu" clase="icono-menu text-xl" />
				<Icono nombre="cerrar" clase="icono-cerrar hidden text-xl" />
			</button>
		</div>
	</nav>
</header>

<!-- Menú móvil a pantalla completa: mismo orden que el de escritorio, CTA al fondo -->
<div
	id="menu-movil"
	hidden
	class="fixed inset-0 z-40 flex flex-col justify-between bg-noche px-6 pt-28 pb-10 md:hidden"
>
	<ul class="flex flex-col gap-2">
		{
			enlaces.map((enlace) => (
				<li>
					<a
						href={enlace.href}
						data-cierra-menu
						class="block py-2 font-display text-4xl font-normal tracking-[-0.015em] text-hueso"
					>
						{enlace.texto}
					</a>
				</li>
			))
		}
	</ul>
	<a
		href="#contacto"
		data-cierra-menu
		class="block rounded-full bg-hueso py-4 text-center font-mono text-[0.85rem] font-medium tracking-[0.14em] text-noche uppercase"
	>
		Iniciar proyecto
	</a>
</div>

<script>
	const cabecera = document.getElementById('cabecera')!;
	const boton = document.getElementById('menu-boton')!;
	const menu = document.getElementById('menu-movil')!;

	// La barra se vuelve sólida en cuanto el hero deja de cubrir la altura del header
	const alSalirDelHero = () => {
		cabecera.dataset.pegada = String(window.scrollY > 80);
	};
	alSalirDelHero();
	window.addEventListener('scroll', alSalirDelHero, { passive: true });

	const textoBoton = boton.querySelector('[data-menu-texto]')!;
	const iconoMenu = boton.querySelector('.icono-menu')!;
	const iconoCerrar = boton.querySelector('.icono-cerrar')!;

	const alternarMenu = (abrir: boolean) => {
		menu.hidden = !abrir;
		boton.setAttribute('aria-expanded', String(abrir));
		textoBoton.textContent = abrir ? 'Cerrar' : 'Menú';
		iconoMenu.classList.toggle('hidden', abrir);
		iconoCerrar.classList.toggle('hidden', !abrir);
		document.body.style.overflow = abrir ? 'hidden' : '';
	};

	boton.addEventListener('click', () => alternarMenu(Boolean(menu.hidden)));
	menu.querySelectorAll('[data-cierra-menu]').forEach((enlace) =>
		enlace.addEventListener('click', () => alternarMenu(false)),
	);
	document.addEventListener('keydown', (evento) => {
		if (evento.key === 'Escape' && !menu.hidden) alternarMenu(false);
	});
</script>
