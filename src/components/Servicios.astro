---
// §05 Ecosistema de Servicios — tres áreas leídas como tabla, no como
// tres tarjetas iguales. La columna de resultado lleva el peso.
const servicios = [
	{
		area: 'Branding Editorial',
		componentes: 'Identidad visual · Brandbook · Naming',
		resultado: 'Posicionamiento premium y diferenciación visual.',
	},
	{
		area: 'Marketing Estratégico',
		componentes: 'Pauta digital (Ads) · Embudos de venta',
		resultado: 'Escalabilidad y conversión medible.',
	},
	{
		area: 'Dirección de Arte',
		componentes: 'Producción audiovisual · Fotografía',
		resultado: 'Contenido que retiene la atención del usuario.',
	},
];
---

<section id="servicios" class="bg-noche py-seccion">
	<div class="mx-auto max-w-[110rem] px-6 lg:px-10">
		<div data-revela class="mb-10">
			<h2 class="font-display text-4xl font-normal tracking-[-0.015em] text-hueso lg:text-6xl">
				Servicios
			</h2>
		</div>

		<div role="list">
			{
				servicios.map((servicio, i) => (
					<div
						role="listitem"
						class="servicio -mx-5 grid gap-3 rounded-3xl px-5 py-9 md:grid-cols-[2rem_1fr_1fr_1.2fr] md:items-baseline md:gap-8"
					>
						<span class="font-mono text-[0.8rem] font-medium text-seda-dim tabular-nums">
							0{i + 1}
						</span>
						<h3 class="font-display text-2xl font-normal tracking-[-0.01em] text-hueso lg:text-3xl">
							{servicio.area}
						</h3>
						<p class="etiqueta leading-relaxed">{servicio.componentes}</p>
						<p class="text-base leading-relaxed text-seda lg:text-lg">
							{servicio.resultado}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Elevación por luz, no por filete: la fila señalada aclara su superficie
	   un punto, como las fases del proceso. */
	.servicio {
		transition: background-color 400ms ease;
	}
	.servicio:hover {
		background-color: var(--color-carbon);
	}

	/* La fila responde al cursor: el área se desliza un punto hacia la
	   derecha, como una entrada de índice que se señala con el dedo. */
	.servicio h3 {
		transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.servicio:hover h3 {
		transform: translateX(0.4rem);
	}
	@media (prefers-reduced-motion: reduce) {
		.servicio h3 {
			transition: none;
		}
		.servicio:hover h3 {
			transform: none;
		}
	}
</style>
