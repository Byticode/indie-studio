---
// §08 Cualificación y Contacto — nunca solo un correo: el formulario pide
// contexto antes de la conversación y filtra a quien no encaja.
//
// PENDIENTE: conectar el envío (endpoint de Astro, Formspree o similar).
// Decisión abierta de la arquitectura: el campo de presupuesto cualifica pero
// cuesta envíos; la alternativa es preguntarlo en el correo de respuesta.
const desafios = [
	'Mi marca no refleja lo que realmente somos',
	'Tengo tráfico, pero no convierte',
	'Necesito contenido que sostenga la atención',
	'Voy a lanzar algo nuevo',
];

const presupuestos = ['$1,000 – $3,000', '$3,000 – $10,000', 'Más de $10,000', 'Prefiero hablarlo'];
---

<section id="contacto" class="bg-noche py-seccion">
	<div class="mx-auto grid max-w-[110rem] gap-16 px-6 lg:grid-cols-2 lg:gap-24 lg:px-10">
		<div>
			<span data-revela class="etiqueta">07 · Contacto</span>
			<h2
				data-revela
				class="mt-6 font-serif text-5xl leading-none font-light text-hueso lg:text-7xl"
				style="letter-spacing: -0.02em; text-wrap: balance;"
			>
				¿Tienes un proyecto <em class="italic">en mente</em>?
			</h2>
			<p data-revela class="mt-8 max-w-[40ch] text-lg leading-relaxed text-seda">
				Cuéntanos el desafío. Respondemos en 48 horas laborables, y solo tomamos
				proyectos donde podemos mover la aguja.
			</p>
		</div>

		<form data-revela class="flex flex-col gap-9" method="post" action="#contacto">
			<div class="grid gap-9 sm:grid-cols-2">
				<label class="campo">
					<span class="etiqueta">Nombre</span>
					<input type="text" name="nombre" required autocomplete="name" />
				</label>
				<label class="campo">
					<span class="etiqueta">Empresa</span>
					<input type="text" name="empresa" required autocomplete="organization" />
				</label>
			</div>

			<label class="campo">
				<span class="etiqueta">Email corporativo</span>
				<input type="email" name="email" required autocomplete="email" />
			</label>

			<label class="campo">
				<span class="etiqueta">¿Cuál es tu mayor desafío actual?</span>
				<select name="desafio" required>
					<option value="" selected disabled>Selecciona una opción</option>
					{desafios.map((desafio) => <option value={desafio}>{desafio}</option>)}
				</select>
			</label>

			<label class="campo">
				<span class="etiqueta">Rango de presupuesto estimado</span>
				<select name="presupuesto">
					<option value="" selected disabled>Selecciona una opción</option>
					{presupuestos.map((rango) => <option value={rango}>{rango}</option>)}
				</select>
			</label>

			<label class="campo">
				<span class="etiqueta">Cuéntanos brevemente (opcional)</span>
				<textarea name="mensaje" rows="3"></textarea>
			</label>

			<button
				type="submit"
				class="self-start bg-hueso px-8 py-4 font-mono text-[0.72rem] tracking-[0.14em] text-noche uppercase transition-colors duration-300 hover:bg-seda"
			>
				Enviar propuesta
			</button>
		</form>
	</div>
</section>

<style>
	.campo {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
	.campo input,
	.campo select,
	.campo textarea {
		background: transparent;
		border: 0;
		border-bottom: 1px solid color-mix(in srgb, var(--color-seda) 30%, transparent);
		padding: 0.55rem 0;
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--color-hueso);
		border-radius: 0;
		transition: border-color 300ms ease;
	}
	.campo select {
		appearance: none;
		cursor: pointer;
	}
	.campo option {
		background: var(--color-carbon);
		color: var(--color-hueso);
	}
	.campo textarea {
		resize: vertical;
	}
	.campo input:focus-visible,
	.campo select:focus-visible,
	.campo textarea:focus-visible {
		outline: none;
		border-bottom-color: var(--color-hueso);
	}
</style>
