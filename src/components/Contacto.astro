---
import Icono from './Icono.astro';

// §08 Cualificación y Contacto — nunca solo un correo: el formulario pide
// contexto antes de la conversación y filtra a quien no encaja.
//
// PENDIENTE: conectar el envío (endpoint de Astro, Formspree o similar).
// Decisión abierta de la arquitectura: el campo de presupuesto cualifica pero
// cuesta envíos; la alternativa es preguntarlo en el correo de respuesta.
const desafios = [
	'Mi marca no refleja lo que realmente somos',
	'Tengo tráfico, pero no convierte',
	'Necesito contenido que sostenga la atención',
	'Voy a lanzar algo nuevo',
];

const presupuestos = ['$1,000 – $3,000', '$3,000 – $10,000', 'Más de $10,000', 'Prefiero hablarlo'];
---

<section id="contacto" class="bg-noche py-seccion">
	<div class="mx-auto grid max-w-[110rem] gap-16 px-6 lg:grid-cols-2 lg:gap-24 lg:px-10">
		<div>
			<span data-revela class="etiqueta">Contacto</span>
			<h2
				data-revela
				class="mt-6 font-display text-5xl leading-[1.05] font-normal text-hueso lg:text-7xl"
				style="letter-spacing: -0.02em; text-wrap: balance;"
			>
				¿Tienes un proyecto en mente?
			</h2>
			<p data-revela class="mt-8 max-w-[40ch] text-lg leading-relaxed text-seda">
				Cuéntanos el desafío. Respondemos en 48 horas laborables, y solo tomamos
				proyectos donde podemos mover la aguja.
			</p>
		</div>

		<form data-revela class="flex flex-col gap-9" method="post" action="#contacto">
			<div class="grid gap-9 sm:grid-cols-2">
				<label class="campo">
					<span class="etiqueta">Nombre</span>
					<input type="text" name="nombre" required autocomplete="name" />
				</label>
				<label class="campo">
					<span class="etiqueta">Empresa</span>
					<input type="text" name="empresa" required autocomplete="organization" />
				</label>
			</div>

			<label class="campo">
				<span class="etiqueta">Email corporativo</span>
				<input type="email" name="email" required autocomplete="email" />
			</label>

			<label class="campo">
				<span class="etiqueta">¿Cuál es tu mayor desafío actual?</span>
				<span class="selector">
					<select name="desafio" required>
						<option value="" selected disabled>Selecciona una opción</option>
						{desafios.map((desafio) => <option value={desafio}>{desafio}</option>)}
					</select>
					<Icono
						nombre="chevron-abajo"
						clase="selector-icono pointer-events-none text-base text-seda-dim"
					/>
				</span>
			</label>

			<label class="campo">
				<span class="etiqueta">Rango de presupuesto estimado</span>
				<span class="selector">
					<select name="presupuesto">
						<option value="" selected disabled>Selecciona una opción</option>
						{presupuestos.map((rango) => <option value={rango}>{rango}</option>)}
					</select>
					<Icono
						nombre="chevron-abajo"
						clase="selector-icono pointer-events-none text-base text-seda-dim"
					/>
				</span>
			</label>

			<label class="campo">
				<span class="etiqueta">Cuéntanos brevemente (opcional)</span>
				<textarea name="mensaje" rows="3"></textarea>
			</label>

			<button
				type="submit"
				data-magnetico
				class="group inline-flex items-center gap-3 self-start rounded-full bg-hueso px-8 py-4 font-mono text-[0.8rem] font-medium tracking-[0.14em] text-noche uppercase transition-colors duration-300 hover:bg-seda"
			>
				Enviar propuesta
				<Icono
					nombre="flecha-arriba-derecha"
					clase="text-sm transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
				/>
			</button>
		</form>
	</div>
</section>

<style>
	.campo {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
	/* Campos rellenos y redondeados: la superficie en Carbón sustituye a la
	   antigua línea inferior. El foco lo señala el anillo global (curvo,
	   porque sigue el radio del campo) más un punto extra de luz. */
	.campo input,
	.campo select,
	.campo textarea {
		width: 100%;
		background: var(--color-carbon);
		border: 0;
		padding: 0.85rem 1.15rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		color: var(--color-hueso);
		border-radius: 1.1rem;
		transition: background-color 300ms ease;
	}
	.campo select {
		appearance: none;
		cursor: pointer;
		padding-right: 2.75rem;
	}
	.campo option {
		background: var(--color-carbon);
		color: var(--color-hueso);
	}
	.campo textarea {
		resize: vertical;
	}
	.campo input:focus-visible,
	.campo select:focus-visible,
	.campo textarea:focus-visible {
		background-color: color-mix(in srgb, var(--color-carbon) 82%, var(--color-seda));
	}

	/* El chevron sustituye a la flecha nativa del select, en el mismo trazo
	   que el resto de iconos de la web. */
	.selector {
		position: relative;
		display: block;
	}
	.selector :global(.selector-icono) {
		position: absolute;
		right: 1.15rem;
		top: 50%;
		transform: translateY(-50%);
	}
</style>
