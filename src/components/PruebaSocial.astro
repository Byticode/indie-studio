---
// §06 Colaboraciones y Prueba Social — tres capas: logos, prensa, voz del cliente.
//
// CONTENIDO PLACEHOLDER: sustituir por las marcas y citas reales.
// Criterio de la arquitectura: con menos de 6 marcas reales, fila estática
// en lugar de marquee; sin prensa, el bloque «Visto en» se omite entero.
const marcas = [
	'CASSIA',
	'VERMÚ NORTE',
	'ATLAS',
	'HOTEL DUE',
	'RÍO STUDIO',
	'FORMA',
	'LAB SIETE',
	'MARGEN',
];

const testimonios = [
	{
		cita: 'Dejamos de competir por precio. Ahora nos eligen antes de preguntar cuánto cuesta.',
		autor: 'Nombre Apellido',
		cargo: 'Fundadora · Cassia',
	},
	{
		cita: 'El primer lote se agotó en un día. El segundo, antes de anunciarlo.',
		autor: 'Nombre Apellido',
		cargo: 'CEO · Vermú Norte',
	},
];
---

<section id="colaboraciones" class="overflow-hidden bg-noche py-seccion">
	<div class="mx-auto mb-14 max-w-[110rem] px-6 lg:px-10">
		<div data-revela>
			<h2 class="font-display text-4xl font-normal tracking-[-0.015em] text-hueso lg:text-6xl">
				Colaboraciones
			</h2>
		</div>
	</div>

	<!-- Cinta continua de marcas en Gris Sedoso: autoridad sin colores ajenos.
	     El contenido va duplicado para que el bucle cierre sin costura.
	     Sin filetes: la cinta se disuelve en los bordes con una máscara. -->
	<div
		data-revela
		class="marquee relative py-8"
		style="mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);"
		aria-label="Marcas con las que hemos trabajado"
	>
		<div class="marquee-pista flex w-max items-center gap-20 pr-20" data-marquee>
			{
				[...marcas, ...marcas].map((marca) => (
					<span
						aria-hidden="true"
						class="font-display text-2xl font-normal tracking-[0.02em] whitespace-nowrap text-seda-dim transition-colors duration-500 hover:text-seda lg:text-3xl"
					>
						{marca}
					</span>
				))
			}
		</div>
		<span class="sr-only">{marcas.join(', ')}</span>
	</div>

	<!-- Voz del cliente: citas cortas en serif grande. Priorizar las que hablan
	     de ventas o imagen, nunca «fue un placer trabajar con ellos». -->
	<div class="mx-auto mt-24 grid max-w-[110rem] gap-16 px-6 md:grid-cols-2 lg:gap-24 lg:px-10">
		{
			testimonios.map((testimonio) => (
				<figure data-revela>
					<blockquote>
						<p class="font-display text-2xl leading-snug font-normal text-hueso lg:text-[2rem]">
							«{testimonio.cita}»
						</p>
					</blockquote>
					<figcaption class="etiqueta mt-6">
						{testimonio.autor} — {testimonio.cargo}
					</figcaption>
				</figure>
			))
		}
	</div>
</section>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Marquee vivo: la pista se desplaza media longitud (una copia) en bucle —
	// el duplicado hace el corte invisible. Al scrollear, la cinta acelera y
	// se inclina según la velocidad, y decae sola al reposo: se siente física,
	// no un gif. En reduced motion queda estática, su estado de reposo.
	gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
		const pista = document.querySelector<HTMLElement>('[data-marquee]');
		if (!pista) return;

		const cinta = gsap.to(pista, { xPercent: -50, ease: 'none', duration: 36, repeat: -1 });
		const inclinar = gsap.quickTo(pista, 'skewX', { duration: 0.5, ease: 'power2.out' });
		let reposo: ReturnType<typeof setTimeout>;

		ScrollTrigger.create({
			trigger: document.body,
			start: 0,
			end: 'max',
			onUpdate(auto) {
				const velocidad = auto.getVelocity();
				gsap.to(cinta, {
					timeScale: 1 + Math.min(Math.abs(velocidad) / 1200, 2.5),
					duration: 0.25,
					overwrite: true,
				});
				inclinar(gsap.utils.clamp(-5, 5, velocidad / 300));

				clearTimeout(reposo);
				reposo = setTimeout(() => {
					gsap.to(cinta, { timeScale: 1, duration: 0.9 });
					inclinar(0);
				}, 150);
			},
		});
	});
</script>
