---
// Iconos Tabler vía webfont (@tabler/icons-webfont), en la variante 300:
// su trazo equivale al 1.5px del antiguo set de la casa. El glifo se
// dimensiona con font-size (text-*) y hereda currentColor como el texto.
type Nombre =
	| 'flecha-arriba-derecha'
	| 'flecha-abajo'
	| 'flecha-arriba'
	| 'chevron-abajo'
	| 'menu'
	| 'cerrar'
	| 'tiktok'
	| 'instagram'
	| 'linkedin'
	| 'behance';

interface Props {
	nombre: Nombre;
	clase?: string;
}

const { nombre, clase = 'text-base' } = Astro.props;

const iconos: Record<Nombre, string> = {
	'flecha-arriba-derecha': 'ti-arrow-up-right',
	'flecha-abajo': 'ti-arrow-down',
	'flecha-arriba': 'ti-arrow-up',
	'chevron-abajo': 'ti-chevron-down',
	menu: 'ti-menu-2',
	cerrar: 'ti-x',
	tiktok: 'ti-brand-tiktok',
	instagram: 'ti-brand-instagram',
	linkedin: 'ti-brand-linkedin',
	behance: 'ti-brand-behance',
};
---

{/* El display:inline-block que necesita transform vive en global.css
   (capa base), para que utilidades como `hidden` puedan seguir ocultándolo. */}
<i class:list={['ti', iconos[nombre], clase]} aria-hidden="true"></i>
