---
// Set de iconos de la casa: un solo lenguaje de trazo (1.5px, esquinas
// redondeadas, currentColor) para toda la web. Inline SVG: sin librerías,
// sin peticiones extra, y hereda el color del texto que lo rodea.
type Nombre =
	| 'flecha-arriba-derecha'
	| 'flecha-abajo'
	| 'flecha-arriba'
	| 'chevron-abajo'
	| 'menu'
	| 'cerrar'
	| 'instagram'
	| 'linkedin';

interface Props {
	nombre: Nombre;
	clase?: string;
}

const { nombre, clase = 'h-4 w-4' } = Astro.props;

const trazos: Record<Nombre, string> = {
	'flecha-arriba-derecha': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
	'flecha-abajo': '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>',
	'flecha-arriba': '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>',
	'chevron-abajo': '<path d="m6 9 6 6 6-6"/>',
	menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
	cerrar: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
	instagram:
		'<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
	linkedin:
		'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4V8h4v2"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
};
---

<svg
	class={clase}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={trazos[nombre]}
/>
