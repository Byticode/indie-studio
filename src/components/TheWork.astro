---
import Icono from './Icono.astro';

// §04 The Work — no fotos bonitas: casos con resultado de negocio.
// Galería horizontal fijada: la sección se clava en pantalla y el scroll
// vertical se traduce en recorrido horizontal (pin + scrub de GSAP).
// El último panel es un CTA: la galería termina vendiendo.
//
// Sin JS o con prefers-reduced-motion, la galería es un scroll horizontal
// nativo (overflow-x) — mismo contenido, interacción estándar.
//
// CONTENIDO PLACEHOLDER: sustituir por los tres casos reales con métrica
// verificable. Un proyecto sin cifra va al final o no entra.
const casos = [
	{
		codigo: 'IS-001™',
		nombre: 'Cassia',
		categoria: 'Hotel boutique · Branding editorial',
		reto: 'Una marca que no reflejaba el nivel de la experiencia.',
		metrica: { prefijo: '+', valor: 40, sufijo: '%', nota: 'engagement en 90 días' },
		tono: 'linear-gradient(135deg, #3a382f 0%, #191a17 60%, #0e0f0d 100%)',
	},
	{
		codigo: 'IS-002™',
		nombre: 'Vermú Norte',
		categoria: 'Bebidas · Dirección de arte',
		reto: 'Lanzamiento sin comunidad ni distribución previa.',
		metrica: { prefijo: '', valor: 24, sufijo: ' h', nota: 'para el sold out del primer lote' },
		tono: 'linear-gradient(160deg, #2c2e2a 0%, #15161a 55%, #0c0d0c 100%)',
	},
	{
		codigo: 'IS-003™',
		nombre: 'Atlas',
		categoria: 'Editorial · Marketing estratégico',
		reto: 'Tráfico alto que no convertía en suscripciones.',
		metrica: { prefijo: '×', valor: 3, sufijo: '', nota: 'retorno sobre pauta digital' },
		tono: 'linear-gradient(120deg, #33302c 0%, #1b1c19 50%, #0d0e0c 100%)',
	},
];
---

<section id="trabajo" class="overflow-hidden bg-noche">
	<div class="flex min-h-svh flex-col justify-center gap-12 py-20">
		<div class="mx-auto w-full max-w-[110rem] px-6 lg:px-10">
			<div data-revela class="flex items-baseline justify-between border-b border-seda/15 pb-6">
				<h2 class="font-display text-4xl font-normal tracking-[-0.015em] text-hueso lg:text-6xl">
					The Work
				</h2>
				<span class="etiqueta hidden md:block">El scroll recorre la galería</span>
			</div>
		</div>

		<div data-galeria class="galeria">
			<div
				data-pista
				class="galeria-pista flex w-max flex-nowrap items-start gap-6 px-6 pr-[10vw] lg:gap-10 lg:px-10"
			>
				{
					casos.map((caso, i) => (
						<article class="caso group relative shrink-0">
							<a href="#contacto" class="flex flex-col">
								{/* Pieza visual placeholder: sustituir por fotografía real del caso.
								    El fondo vive en una capa un 12% más ancha que su marco: es el
								    recorrido del parallax horizontal dentro del recorte. */}
								<div
									class:list={[
										'caso-visual relative h-[38vh] w-auto overflow-hidden sm:h-[42vh] lg:h-[48vh]',
										i === 0 ? 'aspect-[16/10]' : 'aspect-[4/3]',
									]}
								>
									<div
										data-parallax
										class="absolute inset-y-0 -inset-x-[12%]"
										style={`background:${caso.tono}`}
									>
									</div>
									<span class="absolute top-5 right-6 font-mono text-[0.78rem] font-medium tracking-[0.12em] text-seda/80">
										{caso.codigo}
									</span>
									<span class="absolute bottom-5 left-6 font-mono text-[0.7rem] font-medium tracking-[0.14em] text-seda/50 uppercase">
										Imagen pendiente · fotografía del caso
									</span>
								</div>

								{/* w-0 + min-w-full: el texto se ciñe al ancho de la pieza visual
								    en lugar de estirar la tarjeta. */}
								<div class="flex w-0 min-w-full items-end justify-between gap-6 py-6">
									<div>
										<h3 class="inline-flex items-center gap-3 font-display text-2xl font-normal tracking-[-0.01em] text-hueso lg:text-3xl">
											{caso.nombre}
											<Icono
												nombre="flecha-arriba-derecha"
												clase="h-5 w-5 -translate-x-1 text-seda opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0 group-hover:opacity-100"
											/>
										</h3>
										<p class="etiqueta mt-2">{caso.categoria}</p>
										<p class="mt-3 max-w-[36ch] text-base leading-relaxed text-seda">
											{caso.reto}
										</p>
									</div>

									<p class="shrink-0 text-right">
										<span class="block font-sans text-3xl font-normal tracking-[-0.03em] text-hueso tabular-nums lg:text-4xl">
											{caso.metrica.prefijo}
											<span data-contador data-valor={caso.metrica.valor}>
												0
											</span>
											{caso.metrica.sufijo}
										</span>
										<span class="etiqueta mt-2 block">{caso.metrica.nota}</span>
									</p>
								</div>
							</a>
						</article>
					))
				}

				<!-- Cierre de la galería: el siguiente caso es del visitante -->
				<div class="flex h-[38vh] shrink-0 items-center pl-[4vw] sm:h-[42vh] lg:h-[48vh]">
					<div class="flex flex-col items-start gap-8">
						<p
							class="max-w-[14ch] font-display text-4xl font-normal tracking-[-0.015em] text-hueso lg:text-5xl"
							style="text-wrap: balance;"
						>
							¿El siguiente caso es el tuyo?
						</p>
						<a
							href="#contacto"
							data-magnetico
							class="group inline-flex items-center gap-3 bg-hueso px-7 py-4 font-mono text-[0.8rem] font-medium tracking-[0.14em] text-noche uppercase transition-colors duration-300 hover:bg-seda"
						>
							Iniciar proyecto
							<Icono
								nombre="flecha-arriba-derecha"
								clase="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
							/>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* Fallback usable: sin el efecto activo, la galería se desplaza en
	   horizontal de forma nativa. Cuando GSAP fija la sección, .fijada
	   apaga el desplazamiento propio y la pista pasa a moverse por transform. */
	.galeria {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
	}
	.galeria.fijada {
		overflow: clip;
	}
	.galeria-pista {
		will-change: transform;
	}

	/* Hover a lo galería: la pieza respira, el resto queda quieto */
	.caso-visual {
		transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.caso:hover .caso-visual {
		transform: scale(1.015);
	}
	@media (prefers-reduced-motion: reduce) {
		.caso-visual {
			transition: none;
		}
		.caso:hover .caso-visual {
			transform: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const contadores = Array.from(document.querySelectorAll<HTMLElement>('[data-contador]'));

	// Sin animación, las métricas muestran su valor final desde el principio.
	if (sinMovimiento) {
		contadores.forEach((nodo) => {
			nodo.textContent = String(Number(nodo.dataset.valor) || 0);
		});
	}

	gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
		const seccion = document.getElementById('trabajo');
		const galeria = seccion?.querySelector<HTMLElement>('[data-galeria]');
		const pista = seccion?.querySelector<HTMLElement>('[data-pista]');
		if (!seccion || !galeria || !pista) return;

		// Con el efecto activo, el scroll nativo del fallback se apaga:
		// la pista pasa a moverse por transform.
		galeria.classList.add('fijada');
		galeria.scrollLeft = 0;

		// Pin + scrub: la sección se clava y el scroll vertical se convierte
		// en recorrido horizontal. Los valores por función + invalidateOnRefresh
		// recalculan las medidas en cada refresh (resize, carga de fuentes).
		let contado = false;
		const horizontal = gsap.to(pista, {
			x: () => -(pista.scrollWidth - window.innerWidth),
			ease: 'none',
			scrollTrigger: {
				trigger: seccion,
				pin: true,
				scrub: true,
				start: 'top top',
				end: () => `+=${pista.scrollWidth}`,
				invalidateOnRefresh: true,
				onEnter: () => {
					// Las métricas arrancan cuando la galería se fija, una sola vez.
					if (contado) return;
					contado = true;
					contadores.forEach((nodo) => {
						const final = Number(nodo.dataset.valor);
						if (!Number.isFinite(final)) return;
						const progreso = { valor: 0 };
						gsap.to(progreso, {
							valor: final,
							duration: 1.6,
							ease: 'power3.out',
							onUpdate: () => (nodo.textContent = String(Math.round(progreso.valor))),
						});
					});
				},
			},
		});

		// Parallax dentro de cada marco, atado al avance de la propia pista
		// (containerAnimation): la pieza se desliza mientras la galería recorre.
		document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((capa) => {
			const marco = capa.closest<HTMLElement>('.caso-visual');
			if (!marco) return;
			gsap.fromTo(
				capa,
				{ xPercent: -6 },
				{
					xPercent: 6,
					ease: 'none',
					scrollTrigger: {
						trigger: marco,
						containerAnimation: horizontal,
						start: 'left right',
						end: 'right left',
						scrub: true,
					},
				},
			);
		});

		return () => {
			galeria.classList.remove('fijada');
		};
	});
</script>
