---
// §04 The Work — no fotos bonitas: casos con resultado de negocio.
// Cuadrícula asimétrica estilo galería: la primera pieza ocupa el doble.
//
// CONTENIDO PLACEHOLDER: sustituir por los tres casos reales con métrica
// verificable. Un proyecto sin cifra va al final o no entra.
const casos = [
	{
		codigo: 'IS-001™',
		nombre: 'Cassia',
		categoria: 'Hotel boutique · Branding editorial',
		reto: 'Una marca que no reflejaba el nivel de la experiencia.',
		metrica: { prefijo: '+', valor: 40, sufijo: '%', nota: 'engagement en 90 días' },
		tono: 'linear-gradient(135deg, #3a382f 0%, #191a17 60%, #0e0f0d 100%)',
	},
	{
		codigo: 'IS-002™',
		nombre: 'Vermú Norte',
		categoria: 'Bebidas · Dirección de arte',
		reto: 'Lanzamiento sin comunidad ni distribución previa.',
		metrica: { prefijo: '', valor: 24, sufijo: ' h', nota: 'para el sold out del primer lote' },
		tono: 'linear-gradient(160deg, #2c2e2a 0%, #15161a 55%, #0c0d0c 100%)',
	},
	{
		codigo: 'IS-003™',
		nombre: 'Atlas',
		categoria: 'Editorial · Marketing estratégico',
		reto: 'Tráfico alto que no convertía en suscripciones.',
		metrica: { prefijo: '×', valor: 3, sufijo: '', nota: 'retorno sobre pauta digital' },
		tono: 'linear-gradient(120deg, #33302c 0%, #1b1c19 50%, #0d0e0c 100%)',
	},
];
---

<section id="trabajo" class="bg-noche py-seccion">
	<div class="mx-auto max-w-[110rem] px-6 lg:px-10">
		<div
			data-revela
			class="mb-16 flex items-baseline justify-between border-b border-seda/15 pb-6"
		>
			<h2 class="font-display text-3xl font-medium tracking-[-0.02em] text-hueso lg:text-5xl">
				The Work
			</h2>
			<span class="etiqueta">03 · Casos</span>
		</div>

		<div class="grid gap-6 md:grid-cols-2">
			{
				casos.map((caso, i) => (
					<article
						data-revela
						class:list={['caso group relative overflow-hidden', i === 0 && 'md:col-span-2']}
					>
						<a href="#contacto" class="block">
							{/* Pieza visual placeholder: sustituir por fotografía real del caso */}
							<div
								class:list={[
									'caso-visual relative w-full overflow-hidden',
									i === 0 ? 'aspect-[21/9]' : 'aspect-[4/3]',
								]}
								style={`background:${caso.tono}`}
							>
								<span class="absolute top-5 right-6 font-mono text-[0.68rem] tracking-[0.12em] text-seda/70">
									{caso.codigo}
								</span>
								<span class="absolute bottom-5 left-6 font-mono text-[0.62rem] tracking-[0.14em] text-seda/45 uppercase">
									Imagen pendiente · fotografía del caso
								</span>
							</div>

							<div class="flex flex-col gap-4 py-6 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<h3 class="font-display text-2xl font-medium tracking-[-0.02em] text-hueso lg:text-3xl">
										{caso.nombre}
									</h3>
									<p class="etiqueta mt-2">{caso.categoria}</p>
									<p class="mt-3 max-w-[44ch] text-sm leading-relaxed text-seda">
										{caso.reto}
									</p>
								</div>

								<p class="shrink-0 lg:text-right">
									<span class="block font-display text-4xl font-medium tracking-[-0.03em] text-hueso tabular-nums lg:text-5xl">
										{caso.metrica.prefijo}
										<span
											data-contador
											data-valor={caso.metrica.valor}
										>
											0
										</span>
										{caso.metrica.sufijo}
									</span>
									<span class="etiqueta mt-2 block">{caso.metrica.nota}</span>
								</p>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Hover a lo galería: la pieza respira, el resto queda quieto */
	.caso-visual {
		transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.caso:hover .caso-visual {
		transform: scale(1.015);
	}
	@media (prefers-reduced-motion: reduce) {
		.caso-visual {
			transition: none;
		}
		.caso:hover .caso-visual {
			transform: none;
		}
	}
</style>

<script>
	import { animate, inView } from 'motion';

	// Las métricas cuentan desde cero al entrar en pantalla: el número es el
	// protagonista de la tarjeta y la animación lo subraya una sola vez.
	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-contador]').forEach((nodo) => {
		const final = Number(nodo.dataset.valor);
		if (sinMovimiento || !Number.isFinite(final)) {
			nodo.textContent = String(final);
			return;
		}
		inView(
			nodo,
			() => {
				animate(0, final, {
					duration: 1.4,
					ease: [0.16, 1, 0.3, 1],
					onUpdate: (v) => (nodo.textContent = String(Math.round(v))),
				});
			},
			{ amount: 0.8 },
		);
	});
</script>
