---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifiesto from '../components/Manifiesto.astro';
import TheWork from '../components/TheWork.astro';
import Servicios from '../components/Servicios.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Metodologia from '../components/Metodologia.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<main id="contenido">
		<Hero />
		<Manifiesto />
		<TheWork />
		<Servicios />
		<PruebaSocial />
		<Metodologia />
		<Contacto />
	</main>
	<Footer />
</Layout>

<script>
	import { animate, inView, stagger } from 'motion';

	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!sinMovimiento) {
		// Ocultamos sólo ahora: si el script no llega a correr, el contenido
		// se queda visible en lugar de desaparecer.
		document.documentElement.classList.add('listo');

		// Entrada del hero: una sola secuencia orquestada, no efectos sueltos.
		animate(
			'#inicio [data-anim]',
			{ opacity: [0, 1], transform: ['translateY(1.25rem)', 'translateY(0)'] },
			{ duration: 0.9, delay: stagger(0.09, { startDelay: 0.15 }), ease: [0.16, 1, 0.3, 1] },
		);

		// Manifiesto: se revela al entrar en pantalla, una sola vez.
		inView(
			'[data-revela]',
			(elemento) => {
				animate(
					elemento,
					{ opacity: [0, 1], transform: ['translateY(1.5rem)', 'translateY(0)'] },
					{ duration: 1, ease: [0.16, 1, 0.3, 1] },
				);
			},
			{ amount: 0.35 },
		);
	}
</script>
