---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifiesto from '../components/Manifiesto.astro';
import TheWork from '../components/TheWork.astro';
import Servicios from '../components/Servicios.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Metodologia from '../components/Metodologia.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<!-- ScrollSmoother transforma el contenido: todo lo `fixed` (header y menú
	     móvil) vive fuera del wrapper para no quedar atrapado en el transform. -->
	<div id="smooth-wrapper">
		<div id="smooth-content">
			<main id="contenido">
				<Hero />
				<Manifiesto />
				<TheWork />
				<Servicios />
				<PruebaSocial />
				<Metodologia />
				<Contacto />
			</main>
			<Footer />
		</div>
	</div>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { ScrollSmoother } from 'gsap/ScrollSmoother';

	gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

	// Con la galería clavada también en táctil, el resize que provoca la
	// barra de direcciones al ocultarse no debe refrescar los triggers:
	// refrescar en pleno pin hace saltar la sección.
	ScrollTrigger.config({ ignoreMobileResize: true });

	const mm = gsap.matchMedia();

	// Animaciones ligeras — cualquier dispositivo sin movimiento reducido:
	// entrada del hero y revelados. En móvil son todo lo que corre aquí.
	mm.add('(prefers-reduced-motion: no-preference)', () => {
		// Ocultamos sólo ahora: si el script no llega a correr, el contenido
		// se queda visible en lugar de desaparecer.
		document.documentElement.classList.add('listo');

		// Entrada del hero: el titular sube enmascarado línea a línea
		// y el resto llega en cascada, una sola secuencia orquestada.
		//
		// y: 0 explícito en el estado inicial: el translateY(110%) del CSS de
		// arranque se computa a píxeles y GSAP lo absorbería como un `y` fijo
		// separado del yPercent — la línea quedaría fuera de su máscara para
		// siempre. Pisándolo con 0, el único desplazamiento es el yPercent.
		gsap
			.timeline({ defaults: { ease: 'power4.out' } })
			.fromTo(
				'#inicio [data-linea]',
				{ y: 0, yPercent: 110 },
				{ yPercent: 0, duration: 1.2, stagger: 0.14, delay: 0.15 },
			)
			.fromTo(
				'#inicio [data-anim]',
				{ opacity: 0, y: 18 },
				{ opacity: 1, y: 0, duration: 0.9, stagger: 0.09 },
				'-=0.8',
			);

		// Revelado por sección: una vez, y el contenido se queda quieto.
		document.querySelectorAll<HTMLElement>('[data-revela]').forEach((elemento) => {
			gsap.fromTo(
				elemento,
				{ opacity: 0, y: 24 },
				{
					opacity: 1,
					y: 0,
					duration: 1,
					ease: 'power3.out',
					scrollTrigger: { trigger: elemento, start: 'top 82%', once: true },
				},
			);
		});
	});

	// Maquinaria de scroll cinematográfico — solo punteros finos y sin
	// movimiento reducido. En táctil manda el scroll nativo: normalizeScroll
	// apagaba el pan vertical del navegador (touch-action: pan-x) y todo el
	// desplazamiento pasaba a depender de JS en el hilo principal — frágil
	// en el móvil real —, y los colchones de los paneles, sin rueda ni
	// scrollbar de referencia, se sienten como una página atascada.
	mm.add('(pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
		// El scroll suave pasa a manos de GSAP; el nativo de CSS lo duplicaría.
		document.documentElement.style.scrollBehavior = 'auto';

		const suavizador = ScrollSmoother.create({
			wrapper: '#smooth-wrapper',
			content: '#smooth-content',
			smooth: 1,
			effects: false,
		});

		// Con el contenido transformado, los anclas pasan por el suavizador.
		// El salto de accesibilidad (#contenido) se queda nativo e instantáneo.
		const alClicar = (evento: MouseEvent) => {
			if (!(evento.target instanceof Element)) return;
			const enlace = evento.target.closest('a[href^="#"]');
			if (!enlace) return;
			const href = enlace.getAttribute('href')!;
			if (href === '#contenido' || href.length < 2) return;
			const destino = document.querySelector(href);
			if (!destino) return;
			evento.preventDefault();
			suavizador.scrollTo(destino, true);
			history.pushState(null, '', href);
		};
		document.addEventListener('click', alClicar);

		// Paneles apilados: cada sección con [data-panel] se clava cuando su
		// borde inferior toca el de la ventana, aguanta quieta un colchón de
		// scroll — tiempo de lectura — y solo entonces la siguiente se desliza
		// por encima mientras la clavada crece y se apaga.
		//
		// El colchón es el margin-bottom que .listo [data-panel] pone en vh:
		// el margen retrasa la llegada de la siguiente sección y el pin consume
		// ese recorrido con la sección entera en pantalla. La fuente de verdad
		// es el CSS — aquí solo se lee — y al ir en vh la proporción sobrevive
		// los resize sin recalcular.
		//
		// Las secciones conservan su altura natural, así que el «overscroll»
		// sale gratis: una sección más alta que la ventana se recorre entera
		// con scroll nativo antes de clavarse.
		//
		// Fuera de la lista: The Work (ya se clava a sí misma para la galería
		// horizontal; dos pins sobre el mismo elemento entran en conflicto) y
		// Contacto (panel final — desvanecer el formulario mientras se rellena
		// lo inutilizaría, y tras él no queda recorrido para completar el fundido).
		gsap.utils.toArray<HTMLElement>('[data-panel]').forEach((panel) => {
			const margen = () => parseFloat(getComputedStyle(panel).marginBottom);
			const colchon = margen() / window.innerHeight;

			gsap
				.timeline({
					scrollTrigger: {
						trigger: panel,
						start: 'bottom bottom',
						end: () => `+=${window.innerHeight + margen()}`,
						pin: true,
						pinSpacing: false,
						scrub: true,
						invalidateOnRefresh: true,
					},
				})
				// Aguante: la sección completa y quieta mientras el colchón se consume.
				.to({}, { duration: colchon })
				// Relevo: 0.9 del recorrido para el crecimiento y 0.1 para el apagón
				// final — la sección nunca desaparece antes de quedar cubierta.
				.fromTo(panel, { scale: 1, opacity: 1 }, { scale: 1.8, opacity: 0.5, duration: 0.9 })
				.to(panel, { opacity: 0, duration: 0.1 });
		});

		// Al salir del contexto, GSAP revierte smoother y triggers solo;
		// aquí devolvemos lo que tocamos a mano.
		return () => {
			document.removeEventListener('click', alClicar);
			document.documentElement.style.scrollBehavior = '';
		};
	});

	// Botones magnéticos: el CTA se inclina hacia el cursor y vuelve solo.
	// Puntero fino únicamente — en táctil no existe el hover.
	mm.add('(pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
		document.querySelectorAll<HTMLElement>('[data-magnetico]').forEach((boton) => {
			const irX = gsap.quickTo(boton, 'x', { duration: 0.4, ease: 'power3.out' });
			const irY = gsap.quickTo(boton, 'y', { duration: 0.4, ease: 'power3.out' });

			boton.addEventListener('mousemove', (evento) => {
				const caja = boton.getBoundingClientRect();
				irX((evento.clientX - caja.left - caja.width / 2) * 0.25);
				irY((evento.clientY - caja.top - caja.height / 2) * 0.35);
			});
			boton.addEventListener('mouseleave', () => {
				irX(0);
				irY(0);
			});
		});
	});
</script>
